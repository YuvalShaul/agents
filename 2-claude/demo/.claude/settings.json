{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pip install*)",
      "Bash(python -m pip install*)",
      "Bash(uvicorn main:app*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python main.py*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  }
}
